# Firebase Admin SDK service account JSON for the "perchance-pro" project.
# Paste the full JSON as a single line (with escaped quotes) or with backticks.
FIREBASE_SERVICE_ACCOUNT={}

# Razorpay (same account as auto_perchance, one account for both extensions)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Secret generated when adding THIS webhook URL in the Razorpay dashboard.
# Must match the webhook configured for https://<your-vercel-app>.vercel.app/api/webhook
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
