{
  "manifest_version": 3,
  "name": "Perchance Pro",
  "version": "1.0.0",
  "description": "Bulk image generation automation for Perchance",
  "permissions": [
    "storage",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.perchance.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.perchance.org/*"
      ],
      "all_frames": true,
      "js": [
        "index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Perchance Pro"
  }
}
