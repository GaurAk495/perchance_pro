{
  "manifest_version": 3,
  "name": "Perchance Pro",
  "version": "2.0.0",
  "description": "Bulk image generation automation for Perchance",
  "permissions": ["storage", "downloads", "sidePanel", "identity"],
  "host_permissions": ["https://*.perchance.org/*"],
  "key": "",
  "oauth2": {
    "client_id": "52923835846-sm3hor8d9rabkafdg9834mtoj0pss15r.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.perchance.org/*"],
      "all_frames": true,
      "js": ["index.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Perchance Pro",
    "default_icon": {
      "16": "public/icon16.png",
      "32": "public/icon32.png",
      "48": "public/icon48.png",
      "128": "public/icon128.png"
    }
  },
  "icons": {
    "16": "public/icon16.png",
    "32": "public/icon32.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  }
}
